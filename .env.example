# ============================================================================
# 复制为 .env 并填入真实值。.env 已在 .gitignore 中，不会被提交。
# 注意：桌面版二期会把密钥迁移到 Windows 凭据管理器，此处仅用于开发期。
# ============================================================================

# ---------------------------------------------------------------------------
# 1) 转写：火山引擎「录音文件识别」（豆包语音）
#    控制台：https://console.volcengine.com/speech/app
#    新版控制台只需 VOLC_SPEECH_API_KEY；老版控制台需要 APP_ID + ACCESS_TOKEN
# ---------------------------------------------------------------------------
VOLC_SPEECH_APP_ID=
VOLC_SPEECH_ACCESS_TOKEN=
VOLC_SPEECH_API_KEY=

# 资源 ID。可选值：
#   volc.seedasr.auc        模型 2.0 标准版，0.8 元/小时，仅支持 audio.url
#   volc.bigasr.auc_turbo   极速版，支持 audio.data（base64 本地文件），无需轮询
#   volc.bigasr.auc_idle    闲时版，更便宜，仅支持 audio.url
VOLC_ASR_RESOURCE_ID=volc.bigasr.auc_turbo

# ---------------------------------------------------------------------------
# 2) 文本问答 + 写文档：DeepSeek（OpenAI 兼容）
#    https://platform.deepseek.com/api_keys
#
#    模型 ID 可用值（见 GET /models）：deepseek-flash / deepseek-v4-pro
#    注意 "V4 Flash" 是宣传名，不是可调用的 ID，写成 deepseek-v4-flash 会 404。
# ---------------------------------------------------------------------------
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# ---------------------------------------------------------------------------
# 3) 视觉（课件图 / 板书）：火山方舟 Seed 2.1 Turbo
#    https://console.volcengine.com/ark
# ---------------------------------------------------------------------------
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_VISION_MODEL=doubao-seed-2-1-turbo-260628

# ---------------------------------------------------------------------------
# 可选：重排 / 嵌入 若走云端（默认走本地 ONNX，无需填）
# ---------------------------------------------------------------------------
# ARK_EMBEDDING_MODEL=doubao-embedding-vision-250615
