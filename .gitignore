# 环境与密钥
.env
.env.local
.env.*
!.env.example
*.key
*.pem
credentials.json
**/secrets/**

# 机器生成的术语表（可能含课内纠错，手写主表可进库）
vedioai.glossary.auto.yaml

# 数据目录（入库产物：转写、幻灯片图、播放代理、向量、上传暂存）
data/
*.db
*.db-wal
*.db-shm

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/

# 模型文件（按需下载，不入库）
models/
*.onnx

# 评估输出
evals/runs/

# pytest 临时目录（会生成测试用视频/音频）
.pytest-tmp/

# 编辑器
.vscode/
.idea/

# 临时脚本与修复期备份
tmp/

# 上次编码事故的还原/备份产物
*.restored
*.replayed
*.corrupted.bak
*.log
